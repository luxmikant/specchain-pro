{
  "name": "specchain-pro",
  "version": "0.1.0",
  "description": "AI-powered specification generation with blockchain proof-of-authorship",
  "main": "dist/index.js",
  "bin": {
    "spec": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "specification",
    "blockchain",
    "ai",
    "proof-of-authorship",
    "cli",
    "ethereum",
    "layer2",
    "gpt-4",
    "smart-contracts",
    "documentation",
    "developer-tools"
  ],
  "author": "Luxmikant <luxmikant@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxmikant/specchain-pro.git"
  },
  "bugs": {
    "url": "https://github.com/luxmikant/specchain-pro/issues"
  },
  "homepage": "https://github.com/luxmikant/specchain-pro#readme",
  "dependencies": {
    "commander": "^11.1.0",
    "ethers": "^6.10.0",
    "openai": "^4.24.1",
    "keytar": "^7.9.0",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/inquirer": "^8.2.10",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "prettier": "^3.1.1",
    "fast-check": "^3.15.0",
    "@types/jest": "^29.5.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
